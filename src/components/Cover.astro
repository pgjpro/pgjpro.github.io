---
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const d = post.data;
---
{d.cover ? (
  <div class="cover"><img src={d.cover} alt="" loading="lazy" /></div>
) : (
  <div class="cover soft" aria-hidden="true">{d.number && <span>{d.number}</span>}</div>
)}
