---
import type { CollectionEntry } from 'astro:content';
import { fmtDate } from '../site';
interface Props { posts: CollectionEntry<'posts'>[]; withSum?: boolean }
const { posts, withSum = false } = Astro.props;
---
{posts.length === 0 ? (
  <p class="empty">아직 올라온 글이 없습니다.</p>
) : (
  <ul class="rows">
    {posts.map((p) => (
      <li data-search={`${p.data.title} ${p.data.answer ?? ''} ${p.data.category}`.toLowerCase()}>
        <a href={`/posts/${p.id}/`}>
          <span class="cat">{p.data.category}</span>
          <span class="t">
            <span class="title">{p.data.title}{p.data.draft && <em class="draft">작성 중</em>}</span>
            {withSum && p.data.answer && <span class="sum">{p.data.answer}</span>}
          </span>
          <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
        </a>
      </li>
    ))}
  </ul>
)}
