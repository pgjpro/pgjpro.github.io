---
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';
import { fmtDate } from '../site';
interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;
---
{posts.length === 0 ? (
  <p class="empty">아직 글이 없습니다. 첫 글은 src/content/posts 에 추가합니다.</p>
) : (
  <ul class="grid">
    {posts.map((p) => (
      <li>
        <a class="card" href={`/posts/${p.id}/`}>
          <Cover post={p} />
          <p class="meta"><span class="cat">{p.data.category}</span><time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time></p>
          <h3>{p.data.title}{p.data.draft && <em class="draft">작성 중</em>}</h3>
          {p.data.answer && <p class="sum">{p.data.answer}</p>}
        </a>
      </li>
    ))}
  </ul>
)}
