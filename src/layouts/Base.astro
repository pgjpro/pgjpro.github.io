---
import '../styles/global.css';
import { SITE, CATEGORIES } from '../site';
interface Props { title?: string; description?: string; current?: string; type?: 'website' | 'article'; jsonLd?: object; image?: string }
const { title, description = SITE.description, current, type = 'website', jsonLd, image = '/og.png' } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} | ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const nav = [
  { href: '/', label: '홈', key: 'home' },
  { href: '/posts/', label: '글', key: 'posts' },
  { href: '/projects/', label: '프로젝트', key: 'projects' },
  { href: '/about/', label: '소개', key: 'about' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    {SITE.ga4 && (
      <>
        <!-- Google tag (gtag.js) -->
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4}`}></script>
        <script is:inline set:html={`
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', '${SITE.ga4}');
`} />
      </>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL('/rss.xml', Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {SITE.verify.google && <meta name="google-site-verification" content={SITE.verify.google} />}
    {SITE.verify.naver && <meta name="naver-site-verification" content={SITE.verify.naver} />}
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {image === '/og.png' && <meta property="og:image:width" content="1200" />}
    {image === '/og.png' && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/">{SITE.title}</a>
        <nav aria-label="주요 메뉴">
          {nav.map((n) => <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
          <a class="search-btn" href="/posts/#q" aria-label="글 검색">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          </a>
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site-foot">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-about">
            <strong>{SITE.title}</strong>
            <p>{SITE.tagline} 광고를 운영하며 배우고 성장한 과정을 기록합니다.</p>
          </div>
          <div>
            <h2>둘러보기</h2>
            <ul>
              <li><a href="/posts/">글</a></li>
              <li><a href="/category/">카테고리</a></li>
              <li><a href="/projects/">프로젝트</a></li>
              <li><a href="/tags/">태그</a></li>
            </ul>
          </div>
          <div>
            <h2>카테고리</h2>
            <ul>{CATEGORIES.map((c) => <li><a href={`/category/${c.slug}/`}>{c.name}</a></li>)}</ul>
          </div>
          <div>
            <h2>About</h2>
            <ul>
              <li><a href="/about/">소개</a></li>
              <li><a href="/about/#now">요즘</a></li>
              <li><a href="/about/#contact">연락하기</a></li>
            </ul>
          </div>
        </div>
        <p class="copy">© {new Date().getFullYear()} {SITE.title}. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
