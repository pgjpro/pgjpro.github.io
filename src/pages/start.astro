---
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib';
const roadmap = (await getPosts()).filter((p) => p.data.roadmap).sort((a, b) => a.data.roadmap! - b.data.roadmap!);
---
<Base title="읽는 순서" current="start" description="처음 오신 분을 위한 추천 읽기 순서입니다.">
  <header class="page-head">
    <h1>읽는 순서</h1>
    <p class="desc">처음 오셨다면 이 순서대로 읽어 보세요. 실무 문제에서 시작해 측정, 자동화로 이어집니다.</p>
  </header>
  {roadmap.length ? (
    <ol class="steps big">
      {roadmap.map((p, i) => (
        <li>
          <a href={`/posts/${p.id}/`}>
            <span class="step-no">{i + 1}</span>
            <span class="t">
              <span class="cat">{p.data.category}</span>
              <span class="title">{p.data.title}{p.data.draft && <em class="draft">작성 중</em>}</span>
              {p.data.answer && <span class="sum">{p.data.answer}</span>}
            </span>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <p class="empty">아직 읽는 순서가 준비되지 않았습니다.</p>
  )}
</Base>
