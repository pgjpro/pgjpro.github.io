---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Cover from '../components/Cover.astro';
import Now from '../components/Now.astro';
import { getPosts } from '../lib';
import { SITE, CATEGORIES, fmtDate } from '../site';
const all = await getPosts();
// 대표 글: featured 로 고른 글 최대 3개 (없으면 최신 글 1개)
const picked = all.filter((p) => p.data.featured).slice(0, 3);
const featured = picked.length ? picked : all.slice(0, 1);
const recent = all.filter((p) => !featured.includes(p)).slice(0, 6);
const count = (c: string) => all.filter((p) => p.data.category === c).length;
---
<Base current="home">
  <!-- 1. 대문 소개 -->
  <section class="intro">
    <h1>{SITE.tagline}</h1>
    <p class="intro-lead">
      퍼포먼스 마케터로 일하며 마주한 문제와 실험, 그리고 배운 점을 기록합니다.<br />
      이 블로그는 저의 성장 과정이자, 같은 고민을 하는 사람에게 건네는 작은 정리 노트입니다.
    </p>
    <ul class="intro-links">
      <li><a href="/about/">소개 <span aria-hidden="true">→</span></a></li>
      <li><a href="/projects/">프로젝트 <span aria-hidden="true">→</span></a></li>
      <li><a href="/about/#contact">연락하기 <span aria-hidden="true">→</span></a></li>
    </ul>
  </section>

  <!-- 2. 요즘 -->
  <Now />

  <!-- 3. 대표 글 -->
  {featured.length === 1 && (
    <section class="block">
      <div class="sec-head"><h2>대표 글</h2></div>
      {featured.map((p) => (
        <a class="feature" href={`/posts/${p.id}/`}>
          <Cover post={p} />
          <div class="f-body">
            <p class="meta"><span class="cat">{p.data.category}</span><time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time></p>
            <h3>{p.data.title}{p.data.draft && <em class="draft">작성 중</em>}</h3>
            {p.data.answer && <p class="sum">{p.data.answer}</p>}
            <span class="more">읽어보기 <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </section>
  )}
  {featured.length > 1 && (
    <section class="block">
      <div class="sec-head"><h2>대표 글</h2></div>
      <ul class="proj">
        {featured.map((p) => (
          <li>
            <a href={`/posts/${p.id}/`}>
              <Cover post={p} />
              <p class="meta"><span class="cat">{p.data.category}</span><time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time></p>
              <h3>{p.data.title}{p.data.draft && <em class="draft">작성 중</em>}</h3>
              {p.data.answer && <p class="sum">{p.data.answer}</p>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- 4. 최근 글 -->
  <section class="block">
    <div class="sec-head"><h2>최근 글</h2><a href="/posts/">전체 보기 <span aria-hidden="true">→</span></a></div>
    <PostList posts={recent} />
  </section>

  <!-- 5. 인기 글: GA4 데이터가 쌓이면 추가 -->

  <!-- 6. 주제로 둘러보기 -->
  <section class="block">
    <div class="sec-head"><h2>주제로 둘러보기</h2></div>
    <ul class="topics">
      {CATEGORIES.map((c) => (
        <li>
          <a href={`/category/${c.slug}/`}>
            <span class="name">{c.name}</span>
            <span class="desc">{c.desc}</span>
            <span class="count">글 {count(c.name)}개</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
