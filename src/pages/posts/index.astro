---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Cats from '../../components/Cats.astro';
import { getPosts } from '../../lib';
const posts = await getPosts();
// 연도별로 묶기 (최신 연도 먼저)
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))].sort((a, b) => b - a);
---
<Base title="글" current="posts" noindex={posts.length === 0}>
  <header class="page-head">
    <h1>글</h1>
    <label class="search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input id="q" type="search" placeholder="제목이나 내용으로 찾기" aria-label="글 검색" />
    </label>
    <Cats />
  </header>
  {posts.length === 0 && <p class="empty">아직 올라온 글이 없습니다.</p>}
  {years.map((y) => {
    const list = posts.filter((p) => p.data.date.getFullYear() === y);
    return (
      <section class="year" data-year={y}>
        <h2 class="year-h">{y} <small>{list.length}</small></h2>
        <PostList posts={list} withSum />
      </section>
    );
  })}
  <p class="empty" id="no-hit" hidden>찾는 글이 없습니다. 다른 단어로 찾아 보세요.</p>
  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const rows = [...document.querySelectorAll<HTMLElement>('.rows li')];
    const years = [...document.querySelectorAll<HTMLElement>('.year')];
    const none = document.getElementById('no-hit')!;
    if (location.hash === '#q') q.focus();
    q.addEventListener('input', () => {
      const v = q.value.trim().toLowerCase();
      let n = 0;
      rows.forEach((r) => { const hit = !v || (r.dataset.search ?? '').includes(v); r.hidden = !hit; if (hit) n++; });
      years.forEach((y) => (y.hidden = !y.querySelector('.rows li:not([hidden])')));
      none.hidden = n > 0 || rows.length === 0;
    });
  </script>
</Base>
