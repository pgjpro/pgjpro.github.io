---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Cats from '../../components/Cats.astro';
import { getPosts } from '../../lib';
import { SERIES } from '../../site';
const posts = await getPosts();
// 시리즈별로 묶고(시리즈 안에서는 순서대로), 시리즈가 없는 글은 '그 밖의 글'로 모읍니다.
const groups = [
  ...SERIES.map((s) => ({
    name: s.name,
    desc: s.desc,
    list: posts.filter((p) => p.data.series === s.key).sort((a, b) => (a.data.part ?? 99) - (b.data.part ?? 99)),
  })),
  { name: '그 밖의 글', desc: '', list: posts.filter((p) => !SERIES.some((s) => s.key === p.data.series)) },
].filter((g) => g.list.length > 0);
---
<Base title="글" current="posts" noindex={posts.length === 0}>
  <header class="page-head">
    <h1>글</h1>
    <label class="search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input id="q" type="search" placeholder="제목이나 내용으로 찾기" aria-label="글 검색" />
    </label>
    <Cats />
  </header>
  {posts.length === 0 && <p class="empty">아직 올라온 글이 없습니다.</p>}
  {groups.map((g) => (
    <section class="group">
      <h2 class="group-h">{g.name} <small>{g.list.length}편</small></h2>
      {g.desc && <p class="group-desc">{g.desc}</p>}
      <PostList posts={g.list} withSum />
    </section>
  ))}
  <p class="empty" id="no-hit" hidden>찾는 글이 없습니다. 다른 단어로 찾아 보세요.</p>
  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const rows = [...document.querySelectorAll<HTMLElement>('.rows li')];
    const groups = [...document.querySelectorAll<HTMLElement>('.group')];
    const none = document.getElementById('no-hit')!;
    if (location.hash === '#q') q.focus();
    q.addEventListener('input', () => {
      const v = q.value.trim().toLowerCase();
      let n = 0;
      rows.forEach((r) => { const hit = !v || (r.dataset.search ?? '').includes(v); r.hidden = !hit; if (hit) n++; });
      groups.forEach((g) => (g.hidden = !g.querySelector('.rows li:not([hidden])')));
      none.hidden = n > 0 || rows.length === 0;
    });
  </script>
</Base>
