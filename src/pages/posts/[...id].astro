---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib';
import { SITE, slugOf, fmtDate, readMin, tagSlug } from '../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post, others: posts.filter((p) => p.id !== post.id).slice(0, 4) } }));
}
const { post, others } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = new URL(`/posts/${post.id}/`, SITE.url).href;
// 검색엔진용 구조화 데이터 (글 정보)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.answer ?? SITE.description,
  datePublished: d.date.toISOString(),
  dateModified: d.date.toISOString(),
  inLanguage: 'ko-KR',
  mainEntityOfPage: url,
  url,
  image: new URL(d.cover ?? '/og.png', SITE.url).href,
  articleSection: d.category,
  keywords: d.tags.join(', '),
  author: { '@type': 'Person', name: SITE.name, url: new URL('/about/', SITE.url).href },
  publisher: { '@type': 'Person', name: SITE.name },
};
---
<Base title={d.title} description={d.answer} current="posts" type="article" jsonLd={jsonLd} image={d.cover}>
  <article class="article">
    <header class="a-head">
      <a class="cat" href={`/category/${slugOf(d.category)}/`}>{d.category}</a>
      <h1>{d.title}</h1>
      {d.answer && <p class="lead">{d.answer}</p>}
      <p class="byline">{SITE.name} · <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time> · {readMin(post.body)}분 읽기{d.draft && ' · 작성 중'}</p>
    </header>
    {d.cover && <div class="a-cover"><img src={d.cover} alt="" /></div>}
    <div class="prose"><Content /></div>
    {d.tags.length > 0 && (
      <ul class="tag-cloud post-tags">{d.tags.map((t) => <li><a href={`/tags/${tagSlug(t)}/`}># {t}</a></li>)}</ul>
    )}
  </article>

  <aside class="author">
    <strong>{SITE.tagline}</strong>
    <p>{SITE.about}</p>
    <a href="/about/">소개 더 보기 <span aria-hidden="true">→</span></a>
  </aside>

  {others.length > 0 && (
    <section class="latest">
      <div class="sec-head"><h2>다른 글</h2><a href="/posts/">전체 보기 <span aria-hidden="true">→</span></a></div>
      <PostList posts={others} />
    </section>
  )}
</Base>
