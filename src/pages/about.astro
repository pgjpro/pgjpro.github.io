---
import Base from '../layouts/Base.astro';
import Now from '../components/Now.astro';
import { SITE, CATEGORIES } from '../site';
---
<Base title="소개" current="about">
  <section class="about">
    <p class="hello">About</p>
    <h1>{SITE.tagline}</h1>
    <p class="lead">{SITE.about}</p>
    <p>[여기에 직접 소개 글을 더 써 주세요]</p>
    <Now full />
    <dl>
      <dt>지금</dt><dd>{SITE.role}</dd>
      <dt>다루는 것</dt><dd>네이버 검색광고, GFA, Meta, GA4, GTM, SQL, Metabase</dd>
      <dt>쓰는 글</dt><dd>{CATEGORIES.map((c) => c.name).join(', ')}</dd>
      <dt>포트폴리오</dt><dd>[포트폴리오 링크]</dd>
      <dt id="contact">연락</dt><dd><a class="mail" href="mailto:judi8945@naver.com">judi8945@naver.com</a></dd>
    </dl>
  </section>
</Base>
