---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Cats from '../../components/Cats.astro';
import { getPosts } from '../../lib';
import { CATEGORIES } from '../../site';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const posts = (await getPosts()).filter((p) => p.data.category === cat.name);
---
<Base title={cat.name} current="category" noindex={posts.length === 0}>
  <header class="page-head">
    <h1>{cat.name}</h1>
    <p class="desc">{cat.desc}</p>
    <Cats current={cat.name} />
  </header>
  <PostList posts={posts} withSum />
</Base>
